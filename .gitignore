# Dependencies
node_modules/
*/node_modules/
vendor/
backend/vendor/

# Next.js build and environment
ams-frontend/.next/
ams-frontend/out/
ams-frontend/build/

# Environment files (sensitive credentials)
.env
.env.backup
.env.production
ams-frontend/.env
ams-frontend/.env*.local
backend/.env

# Laravel storage and cache
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
!backend/storage/app/.gitignore
!backend/storage/framework/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

# Logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and OS
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
