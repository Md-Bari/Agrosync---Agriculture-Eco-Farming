# Docker Compose settings. Copy to .env (git-ignored) and adjust:
#   cp .env.docker.example .env

APP_NAME=AgroSync
# Use "production" for any real deployment. "local" allows loading demo data.
APP_ENV=local
APP_DEBUG=false
# Leave empty to have one generated on first start and kept in the storage volume.
APP_KEY=

# URLs as seen from the user's browser. The frontend bakes API_URL in at build
# time, so rebuild it (docker compose build frontend) after changing these.
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_PORT=8000
FRONTEND_PORT=3000
MAILPIT_PORT=8025

# Database (required). Use long random values.
DB_DATABASE=agrosync
DB_USERNAME=agrosync
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Outgoing mail. By default OTP emails go to Mailpit: open http://localhost:8025.
# For real delivery set MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD/MAIL_SCHEME.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@agrosync.local

# Load the demo accounts (all with password "password123") on first start.
# Only works with APP_ENV other than production.
SEED_DEMO_DATA=true

# Payments. The simulator lets you test checkout without gateway accounts;
# it must be false in production.
PAYMENTS_MOCK_ENABLED=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Optional: live forecasts from weatherapi.com (falls back to stored data).
WEATHER_API_KEY=
