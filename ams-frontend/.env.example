# AgriculMS Frontend Environment Variables
# Copy this file to .env.local and fill in values

# Laravel API base URL (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App config
NEXT_PUBLIC_APP_NAME=AgriculMS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local UI development without a backend: browser-only fake data, demo logins and
# OTP 123456. Never enable this in a deployed build.
NEXT_PUBLIC_ENABLE_MOCK_API=false

# Feature flags
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_VIDEO_CONSULT=false
